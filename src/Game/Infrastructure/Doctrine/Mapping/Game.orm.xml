<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity name="App\Game\Domain\Model\Game" table="game" schema="game">
        <id name="id" type="integer" column="id">
            <generator/>
        </id>

        <field name="status" enum-type="App\Game\Domain\Model\GameStatus" column="status"/>

        <many-to-many field="players" target-entity="App\Player\Domain\Model\Player">
            <join-table name="game_player" schema="game">
                <join-columns>
                    <join-column name="game_id"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="player_id"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <one-to-many field="scorings" target-entity="App\Scoring\Domain\Model\Scoring" mapped-by="game"/>
    </entity>
</doctrine-mapping>