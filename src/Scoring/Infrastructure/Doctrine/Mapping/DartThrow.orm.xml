<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity name="App\Scoring\Domain\Model\DartThrow" table="dart_throw" schema="scoring">
        <id name="id" type="integer" column="id">
            <generator/>
        </id>

        <field name="multiplication" enum-type="App\Scoring\Domain\Model\Enum\MultiplicationEnum"
               column="multiplication" type="integer"/>
        <field name="section" enum-type="App\Scoring\Domain\Model\Enum\SectionEnum" column="section" type="integer"/>

        <many-to-one field="scoring" target-entity="App\Scoring\Domain\Model\Scoring" inversed-by="dartThrows">
            <join-column name="scoring_id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>