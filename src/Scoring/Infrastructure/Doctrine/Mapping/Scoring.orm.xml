<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity name="App\Scoring\Domain\Model\Scoring" table="scoring" schema="scoring">
        <id name="id" type="integer" column="id">
            <generator/>
        </id>

        <many-to-one field="game" target-entity="App\Game\Domain\Model\Game" inversed-by="scorings">
            <join-column name="game_id" nullable="false"/>
        </many-to-one>

        <many-to-one field="player" target-entity="App\Player\Domain\Model\Player" inversed-by="scorings">
            <join-column name="player_id" nullable="false"/>
        </many-to-one>

        <one-to-many field="dartThrows" target-entity="App\Scoring\Domain\Model\DartThrow" mapped-by="scoring"/>
    </entity>
</doctrine-mapping>